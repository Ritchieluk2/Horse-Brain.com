# Copy to .env for local development (.env is git-ignored).
# In production, set it as a Cloudflare secret:
#   npx wrangler secret put NUXT_SESSION_SECRET

# Seals the sign-in cookie. 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_SECRET=

# Outgoing email via Resend (server/utils/email.ts).
# Sending-only API key, limited to the mail.horse-brain.com domain.
RESEND_API_KEY=
EMAIL_FROM="HorseBrain <noreply@mail.horse-brain.com>"
EMAIL_REPLY_TO=info@horse-brain.com
